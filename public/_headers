# Cabeceras de seguridad que Cloudflare agrega a todas las respuestas.
# Si cambia el proyecto de Supabase, actualizar el dominio en la línea de CSP.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https://aynronszcpwepvkcyrbu.supabase.co https://*.googleusercontent.com; connect-src 'self' https://aynronszcpwepvkcyrbu.supabase.co wss://aynronszcpwepvkcyrbu.supabase.co https://*.ingest.sentry.io https://*.ingest.us.sentry.io; worker-src 'self'; manifest-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# El service worker y el manifiesto se revisan siempre, para que las actualizaciones lleguen enseguida
/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json

# Las páginas (/, /portal, /admin…) salen de index.html por el modo SPA y reciben el
# Cache-Control por defecto de Cloudflare (max-age=0, must-revalidate): siempre se revalidan.

/workbox-*.js
  Cache-Control: public, max-age=31536000, immutable

/splash/*
  Cache-Control: public, max-age=2592000

/icons/*
  Cache-Control: public, max-age=2592000
